# ==============================================================================
# EduBridge Adaptive - Environment Configuration Template
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=*

# Authentication
JWT_SECRET=replace_with_strong_secret_key_minimum_32_characters_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# PRIMARY AND MANDATORY DATABASE: Snowflake
# Do NOT replace Snowflake with MongoDB, PostgreSQL, Supabase, or MySQL.
SNOWFLAKE_ACCOUNT=your_org_account
SNOWFLAKE_USERNAME=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=EDUBRIDGE_ADAPTIVE
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
# Fallback to in-memory SQL mock engine when Snowflake credentials are not configured
SNOWFLAKE_MOCK_FALLBACK=true

# MANDATORY MEDIA STORAGE: Cloudinary
# Stores raw & processed textbook scans, audio narration MP3s, and waveforms
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=edubridge
CLOUDINARY_MOCK_FALLBACK=true

# MULTIMODAL AI: Google Gemini
# Used for OCR, tactile diagram descriptions, sensory analogy lessons, questions
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MOCK_FALLBACK=true

# TEXT-TO-SPEECH: Piper TTS (Local Neural TTS)
# Replaces Google Cloud TTS. Uses local ONNX model or lightweight HTTP sidecar.
PIPER_VOICE=en_US-lessac-medium
PIPER_BIN_PATH=piper
PIPER_MODEL_PATH=
PIPER_HTTP_URL=
PIPER_SPEAKING_RATE=1.0
PIPER_MOCK_FALLBACK=true

# SPEECH RECOGNITION: faster-whisper
# Transcribes student voice answers for interactive quiz assessment
WHISPER_HTTP_URL=
WHISPER_MODEL=base.en
WHISPER_MOCK_FALLBACK=true

# OPTIONAL SECONDARY DATABASE: MySQL
# Secondary read cache / SIS sync adapter ONLY. Never replaces Snowflake.
MYSQL_ENABLED=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=edubridge_secondary

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
